# Run node setup.mjs to generate a local .env containing random login secrets.
PUBLIC_URL=http://localhost:3080
PORT=3080
# For Docker: leave loopback for local testing. For NPM, set the Unraid LAN IP.
BIND_ADDRESS=127.0.0.1
APP_PASSWORD=replace-with-at-least-12-characters
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Container path. Leave empty for the initial image-parsing test.
GOOGLE_APPLICATION_CREDENTIALS=
SHIFT_TITLE=Reachel
MAX_PARSES_PER_DAY=20
DEMO_MODE=0
